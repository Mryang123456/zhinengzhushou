# 仅在需要独立配置时复制此文件为 .env.local。
# OPENAI_API_KEY 已由安全创建流程写入 .env.local。
# 统一模型配置。切换模型时只修改以下变量，无需修改 agent.py。
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
MODEL_TEMPERATURE=0
# MODEL_BASE_URL=http://localhost:11434

# 服务端保护：生产环境必须设置为随机长密钥；客户端以 X-Agent-Api-Key 请求头携带。
# AGENT_API_KEY=请替换为随机长密钥
# AGENT_RATE_LIMIT=20
# AGENT_RATE_WINDOW_SECONDS=60
# AGENT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# OpenAI 使用 OPENAI_API_KEY；Anthropic 使用 ANTHROPIC_API_KEY；Google 使用 GOOGLE_API_KEY。
# Ollama 不需要 API Key，请先在本机启动 Ollama 服务。

# 生产环境长期记忆数据库。未设置时，智能体回退至本地 SQLite。
# MEMORY_DATABASE_URL=postgresql://agent:请替换为强密码@localhost:5432/agent_memory
# 任务断点恢复数据库；本地可与 MEMORY_DATABASE_URL 使用同一个 PostgreSQL。
# CHECKPOINT_DATABASE_URL=postgresql://agent:请替换为强密码@localhost:5432/agent_memory
