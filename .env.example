# 仅在需要独立配置时复制此文件为 .env.local。
# OPENAI_API_KEY 已由安全创建流程写入 .env.local。
# 统一模型配置。切换模型时只修改以下变量，无需修改 agent.py。
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
MODEL_TEMPERATURE=0
# MODEL_BASE_URL=http://localhost:11434

# 服务端保护：生产环境必须设置为随机长密钥；客户端以 X-Agent-Api-Key 请求头携带。
# ENVIRONMENT=production
# AGENT_API_KEY=请替换为随机长密钥
# AGENT_RATE_LIMIT=20
# AGENT_RATE_WINDOW_SECONDS=60
# AGENT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 登录接口独立限流，防止密码猜测；生产环境建议由网关/WAF 叠加防护。
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW_SECONDS=900

# 生产 JWT 身份认证。启用后，聊天、知识库、记忆及 MCP 审批均从 Bearer 令牌取得用户身份。
# AUTH_REQUIRED=true
# JWT_SECRET=请设置至少32字符的随机密钥
# JWT_ISSUER=zhixing-agent
# JWT_AUDIENCE=zhixing-web
# JWT_EXPIRES_MINUTES=30
# AUTH_BOOTSTRAP_USER=你的初始管理员用户名
# AUTH_BOOTSTRAP_PASSWORD_HASH=pbkdf2_sha256$...（不要存储明文密码）

# 多实例生产模式：启用后拒绝内存限流、SQLite 审批及 MemorySaver 回退。
# MULTI_INSTANCE_MODE=true
# REDIS_PASSWORD=请设置强密码
# REDIS_URL=redis://:请替换为强密码@localhost:6379/0

# 工具执行预算与超时；超过预算或时限会安全终止。
# AGENT_MAX_TOOL_CALLS=6
# AGENT_MAX_TOOL_BATCH=3
# 单次模型仅暴露策略白名单中最相关的候选工具数。
# AGENT_TOOL_CANDIDATE_LIMIT=5
# 第一阶段工具召回数量；设置 provider=openai 后会使用语义向量召回，否则使用本地词面降级。
# AGENT_TOOL_RETRIEVAL_LIMIT=12
# TOOL_RETRIEVAL_EMBEDDING_PROVIDER=openai
# TOOL_RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_TOOL_TIMEOUT_SECONDS=20
# AGENT_REQUEST_TIMEOUT_SECONDS=90
# 同一会话并发时等待上一轮写完 Checkpoint 的最长秒数。
# AGENT_THREAD_QUEUE_TIMEOUT_SECONDS=120
# 会话上下文治理：Checkpoint 保留全文审计，但模型仅接收滚动摘要和最近完整回合。
# 默认按 128K 总窗口运行；仅在所选模型上下文窗口不少于此值时启用。
# CONTEXT_WINDOW_TOKENS=131072
# CONTEXT_RESPONSE_RESERVE_TOKENS=8192
# CONTEXT_SUMMARY_TIMEOUT_SECONDS=15
# 生产 MCP 隔离门禁；启用后仅允许声明 isolation=container 的服务启动。
# MCP_SANDBOX_REQUIRED=true

# 记忆保留期及可观测性。
# MEMORY_TTL_DAYS=365

# OpenAI 使用 OPENAI_API_KEY；Anthropic 使用 ANTHROPIC_API_KEY；Google 使用 GOOGLE_API_KEY。
# Ollama 不需要 API Key，请先在本机启动 Ollama 服务。

# 生产环境长期记忆数据库。未设置时，智能体回退至本地 SQLite。
# MEMORY_DATABASE_URL=postgresql://agent:请替换为强密码@localhost:5432/agent_memory
# 任务断点恢复数据库；本地可与 MEMORY_DATABASE_URL 使用同一个 PostgreSQL。
# CHECKPOINT_DATABASE_URL=postgresql://agent:请替换为强密码@localhost:5432/agent_memory
# 配置 PostgreSQL Checkpoint 后，每个 API 进程的后台聊天 worker 数。
# AGENT_RUN_WORKERS=2
# 知识库与 pgvector；未设置时不会暴露内部知识库检索工具。
# KNOWLEDGE_DATABASE_URL=postgresql://agent:请替换为强密码@localhost:5432/agent_memory
# KNOWLEDGE_EMBEDDING_PROVIDER=openai
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# 向量候选使用原始余弦相似度门槛，全文候选使用独立的查询词覆盖率门槛。
# KNOWLEDGE_MIN_SCORE=0.22
# KNOWLEDGE_MAX_DOCUMENT_BYTES=10485760
# 结构化切片按估算 token 控制，重叠只发生在同一章节内。
# KNOWLEDGE_CHUNK_TOKENS=500
# KNOWLEDGE_CHUNK_OVERLAP_TOKENS=80
# 检索命中后最多扩展前后各 1 个同章节片段；范围限制为 0-2。
# KNOWLEDGE_NEIGHBOR_WINDOW=1
# 每个证据窗口的最大估算 token 数。
# KNOWLEDGE_EVIDENCE_TOKENS=1800
# 可选的本地 Cross-Encoder，填写已准备好的模型目录。
# KNOWLEDGE_RERANK_MODEL=./models/bge-reranker-v2-m3
# KNOWLEDGE_RERANK_DEVICE=cpu
# KNOWLEDGE_RERANK_TIMEOUT_SECONDS=5
