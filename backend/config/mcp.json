{
  "mcpGovernance": {
    "allowedServers": ["weather", "search"],
    "toolRisk": {
      "weather_": "L1",
      "search_": "L1"
    },
    "timeoutSeconds": 15,
    "retries": 1
  },
  "mcpServers": {
    "weather": {
      "command": "python",
      "args": ["-m", "backend.app.mcp.weather_server"],
      "transport": "stdio"
    },
    "search": {
      "command": "ddgs",
      "args": ["mcp"],
      "transport": "stdio"
    }
  }
}
