{
  "mcpGovernance": {
    "allowedServers": ["weather", "search"],
    "toolRisk": {
      "weather_": "L1",
      "search_": "L1"
    },
    "toolPolicies": {
      "weather_current_weather": {
        "arguments": {
          "location": {"type": "string", "required": true, "minLength": 1, "maxLength": 80}
        }
      },
      "search_": {
        "arguments": {
          "query": {"type": "string", "required": true, "minLength": 1, "maxLength": 500},
          "max_results": {"type": "integer", "minimum": 1, "maximum": 8}
        }
      }
    },
    "timeoutSeconds": 15,
    "retries": 1,
    "maxToolCalls": 6,
    "maxToolBatch": 3,
    "serverPolicies": {
      "weather": {"command": "python", "args": ["-m", "backend.app.mcp.weather_server"], "transport": "stdio", "isolation": "local"},
      "search": {"command": "ddgs", "args": ["mcp"], "transport": "stdio", "isolation": "local"}
    }
  },
  "mcpServers": {
    "weather": {
      "command": "python",
      "args": ["-m", "backend.app.mcp.weather_server"],
      "transport": "stdio"
    },
    "search": {
      "command": "ddgs",
      "args": ["mcp"],
      "transport": "stdio"
    }
  }
}
